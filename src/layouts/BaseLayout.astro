---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import SkinSwitcher from '../components/SkinSwitcher.astro';

const {
  title = 'fight-1 · AI 学习笔记',
  description = 'fight-1 的 AI 学习资料汇总：Agent / Skill / MCP / LLM / Token 优化 / UI 设计 …',
  ogImage = '/og-default.svg',
  ogType = 'website',
  noindex = false,
} = Astro.props;

const siteName = 'fight-1 的 AI 学习笔记';
const canonical = Astro.url.href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
// 站点级结构化数据（每页复用）
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  url: Astro.site?.href,
  description,
};
---

<!doctype html>
<html lang="zh-CN" data-skin="cosmic" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#5eead4" />
    <link rel="preconnect" href="https://static.cloudflareinsights.com" crossorigin />
    <link rel="preconnect" href="https://giscus.app" crossorigin />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
    <script is:inline>
      (function () {
        try {
          var root = document.documentElement;
          var s = localStorage.getItem('skin') || 'cosmic';
          var tRaw = localStorage.getItem('theme');
          var mqLight = window.matchMedia('(prefers-color-scheme: light)');
          function resolveTheme(v){ if(!v || v==='auto') return mqLight.matches ? 'light':'dark'; return v; }
          root.setAttribute('data-skin', s);
          root.setAttribute('data-theme', resolveTheme(tRaw));
          // 专注阅读模式（对齐方式：默认居左，可选居中）
          if ((localStorage.getItem('focus') || 'off') === 'on') root.setAttribute('data-focus', 'on');
          var fa = localStorage.getItem('focus_align');
          root.setAttribute('data-focus-align', fa === 'center' ? 'center' : 'left');
          // 首次进入若没有记忆的背景，按皮肤×明暗选最契合的默认（避免 FOUC）
          var bgMap = {
            cosmic:  { dark: 'constellation', light: 'constellation' },
            cyber:   { dark: 'matrix',        light: 'grid' },
            xianxia: { dark: 'rune',          light: 'rune' },
            ink:     { dark: 'brush',         light: 'brush' },
            minimal: { dark: 'float',         light: 'float' },
          };
          var b = localStorage.getItem('bg');
          var defBg = (bgMap[s] && (bgMap[s][t] || bgMap[s].dark)) || 'constellation';
          root.setAttribute('data-bg', b || defBg);
          // 动态交互默认：粒子力场（排斥）/ 点击动效 全局开启
          root.setAttribute('data-bg-force', localStorage.getItem('bg_force') || 'repel');
          root.setAttribute('data-bg-click', localStorage.getItem('bg_click') || 'on');
          root.classList.add('no-trans');
          window.addEventListener('load', function () { root.classList.remove('no-trans'); });
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主内容</a>
    <canvas id="bg"></canvas>
    <div id="read-progress" aria-hidden="true"><div></div></div>
    <Nav />
    <main id="main" class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 sm:py-10">
      <slot />
    </main>
    <footer class="mx-auto w-full max-w-6xl px-4 pb-10 pt-6 text-center text-sm text-muted sm:px-6">
      <p>fight-1 的 AI 学习笔记 · 由 Astro 驱动 · 内容即源码</p>
      <p class="mt-1"><span id="visit-counter" class="visit-counter"></span></p>
      <p class="mt-1"><a href="https://github.com/fight-1/AI-learning" target="_blank" rel="noopener noreferrer" style="color:var(--accent);text-decoration:none;">GitHub 开源地址 ↗</a></p>
    </footer>

    <script>
      const root = document.documentElement;
      function setSkin(s) {
        root.setAttribute('data-skin', s);
        try { localStorage.setItem('skin', s); } catch (e) {}
        markActive();
      }
      function resolveTheme(v){ var mq=window.matchMedia('(prefers-color-scheme: light)'); if(!v||v==='auto') return mq.matches?'light':'dark'; return v; }
      function setTheme(v) {
        try { localStorage.setItem('theme', v); } catch (e) {}
        root.setAttribute('data-theme', resolveTheme(v));
        updateThemeIcon(v);
      }
      function markActive() {
        const cur = root.getAttribute('data-skin');
        document.querySelectorAll('[data-skin-set]').forEach((b) => {
          b.classList.toggle('is-active', b.getAttribute('data-skin-set') === cur);
        });
      }
      function updateThemeIcon(v) {
        const i = document.querySelector('[data-theme-toggle]');
        if (!i) return;
        const mode = v || localStorage.getItem('theme') || 'auto';
        i.textContent = mode === 'light' ? '☾' : mode === 'auto' ? '🖥' : '☀';
        i.setAttribute('aria-label', mode === 'auto' ? '跟随系统（自动）' : mode === 'light' ? '切换为深色' : '切换为浅色');
      }
      document.querySelectorAll('[data-skin-set]').forEach((b) => {
        b.addEventListener('click', () => setSkin(b.getAttribute('data-skin-set')));
      });
      const tt = document.querySelector('[data-theme-toggle]');
      if (tt) tt.addEventListener('click', () => {
        const cur = localStorage.getItem('theme') || 'auto';
        setTheme(cur === 'dark' ? 'light' : cur === 'light' ? 'auto' : 'dark');
      });
      const trig = document.querySelector('[data-skin-trigger]');
      const panel = document.querySelector('[data-skin-panel]');
      if (trig && panel) {
        trig.addEventListener('click', (e) => {
          e.stopPropagation();
          panel.hidden = !panel.hidden;
        });
        document.addEventListener('click', (e) => {
          if (!panel.contains(e.target) && !trig.contains(e.target)) panel.hidden = true;
        });
      }
      markActive();
      updateThemeIcon();
      // 自动主题：auto 模式实时跟随系统配色偏好
      window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
        if ((localStorage.getItem('theme') || 'auto') === 'auto') {
          root.setAttribute('data-theme', window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
          updateThemeIcon('auto');
        }
      });
      // 专注阅读模式（控制台 / 文章页调用 window.__setFocus）
      window.__setFocus = function (on) {
        root.setAttribute('data-focus', on ? 'on' : 'off');
        try { localStorage.setItem('focus', on ? 'on' : 'off'); } catch (e) {}
      };
      // 专注模式对齐：'left'（默认）| 'center'
      window.__setFocusAlign = function (v) {
        const a = v === 'center' ? 'center' : 'left';
        root.setAttribute('data-focus-align', a);
        try { localStorage.setItem('focus_align', a); } catch (e) {}
        return a;
      };
      window.__getFocusAlign = function () {
        return root.getAttribute('data-focus-align') || (localStorage.getItem('focus_align') === 'center' ? 'center' : 'left');
      };
      // 搜索快捷键：按 / 聚焦搜索（输入框内不触发）
      document.addEventListener('keydown', (e) => {
        if (e.key === '/' && !/^(input|textarea|select)$/i.test(e.target.tagName) && !e.target.isContentEditable) {
          e.preventDefault();
          if (location.pathname === '/search') {
            const s = document.getElementById('search') || document.querySelector('.pagefind-ui__search-input');
            if (s) s.focus();
          } else location.assign('/search');
        }
      });
    </script>

    <button id="to-top" aria-label="返回顶部">↑</button>

    <script>
      import '../scripts/bg.js';
      import '../scripts/fx.js';
      import '../scripts/cursor.js';
      import '../scripts/landing.js';
      import { initAudio, blipThrottled, panFromX } from '../scripts/audio.js';
      import { initRadar } from '../scripts/radar.js';
      import { initCryo } from '../scripts/warp.js';
      import { initComm } from '../scripts/interactions.js';
      import { initAchievements, initEaster } from '../scripts/console.js';
      import '../scripts/visit-counter.js';
      initAudio();
      initRadar();
      // initWarp() 已关闭：克隆卡片放大→跳转的中间帧会被误认为「短暂进入新页面」，
      // 体感割裂阅读流。改为原生即时跳转；保留导出 initWarp 以便日后控制台启用。
      initCryo();
      initComm();
      initAchievements();
      initEaster();
      // 星际广播发送音效
      document.addEventListener('comm:sent', () => blipThrottled(760, 0));
    </script>

    <!-- Cloudflare Web Analytics -->
    <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "c90144522a1a46aa9b7046a1178bd5f0"}'></script>
    <!-- End Cloudflare Web Analytics -->

    <!-- PWA：注册 Service Worker（离线可读 / 回访秒开） -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    </script>
  </body>
</html>
