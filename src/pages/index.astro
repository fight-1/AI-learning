---
import BaseLayout from '../layouts/BaseLayout.astro';
import NoteCard from '../components/NoteCard.astro';
import { getNotes, uniqueCategories, uniqueTags } from '../lib/notes';

const notes = await getNotes();
const recent = notes.slice(0, 6);
const cats = uniqueCategories(notes);
const tags = uniqueTags(notes);
const stats = { notes: notes.length, tags: tags.length, cats: cats.length };
---

<BaseLayout>
  <section class="hero">
    <p class="hero-kicker">AI LEARNING NOTES</p>
    <h1 class="hero-title glow-text">fight-1 的 AI 学习笔记</h1>
    <p class="hero-sub">把 Agent · Skill · MCP · LLM · Token 优化 · UI 设计… 学懂、记下、串起来。</p>
    <div class="hero-actions">
      <a href="/notes" class="btn btn-primary">开始阅读</a>
      <a href="/subscribe" class="btn">RSS 订阅</a>
    </div>
  </section>

  <section class="stats" data-reveal>
    <a class="stat" href="/notes"><b>{stats.notes}</b><span>篇笔记</span></a>
    <a class="stat" href="/categories"><b>{stats.cats}</b><span>个分类</span></a>
    <a class="stat" href="/tags"><b>{stats.tags}</b><span>个标签</span></a>
  </section>

  <section class="block" data-reveal>
    <div class="block-head">
      <h2>最新笔记</h2>
      <a href="/notes" class="more">全部 →</a>
    </div>
    <div class="grid">
      {recent.map((n) => <NoteCard note={n} />)}
    </div>
  </section>

  <section class="block" data-reveal>
    <div class="block-head"><h2>按分类游览</h2></div>
    <div class="chips">
      {cats.map((c) => (
        <a class="chip" href={`/notes?category=${encodeURIComponent(c)}`}># {c}</a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    text-align: center;
    padding: 48px 0 36px;
  }
  .hero-kicker {
    letter-spacing: 4px;
    font-size: 12px;
    color: var(--muted);
    margin: 0 0 12px;
  }
  .hero-title {
    font-size: clamp(28px, 6vw, 52px);
    margin: 0 0 14px;
    font-weight: 700;
    line-height: 1.1;
  }
  .hero-sub {
    color: var(--muted);
    max-width: 560px;
    margin: 0 auto 24px;
    font-size: 15px;
  }
  .hero-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 10px 20px;
    border-radius: 10px;
    border: 1px solid var(--border);
    color: var(--text);
    background: var(--surface);
    font-size: 14px;
  }
  .btn:hover {
    text-decoration: none;
    border-color: var(--accent);
  }
  .btn-primary {
    background: var(--accent);
    color: #04121a;
    border-color: var(--accent);
    font-weight: 600;
  }
  .stats {
    display: flex;
    gap: 12px;
    justify-content: center;
    margin: 8px 0 36px;
  }
  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 14px 26px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    transition: border-color .15s, transform .15s;
  }
  .stat:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    text-decoration: none;
  }
  .stat b {
    font-size: 22px;
    color: var(--accent);
  }
  .stat span {
    font-size: 12px;
    color: var(--muted);
  }
  .block {
    margin-top: 36px;
  }
  .block-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 16px;
  }
  .block-head h2 {
    font-size: 20px;
    margin: 0;
  }
  .more {
    font-size: 13px;
    color: var(--muted);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
</style>
