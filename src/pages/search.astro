---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="搜索 · fight-1">
  <h1>搜索</h1>
  <input id="q" class="search-input" type="search" placeholder="输入关键词，按标题 / 摘要 / 标签过滤…" autofocus />
  <p id="stat" class="muted"></p>
  <div id="results" class="results"></div>
</BaseLayout>

<style>
  h1 { font-size: 26px; margin: 0 0 14px; }
  .search-input {
    width: 100%;
    padding: 12px 16px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    font-size: 15px;
    font-family: inherit;
    outline: none;
  }
  .search-input:focus { border-color: var(--accent); }
  .muted { color: var(--muted); font-size: 13px; margin: 10px 0; }
  .results { display: flex; flex-direction: column; gap: 12px; margin-top: 8px; }
  .item {
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .item a { color: var(--text); font-size: 16px; font-weight: 600; }
  .item a:hover { color: var(--accent); text-decoration: none; }
  .item .s { color: var(--muted); font-size: 13px; margin: 6px 0; }
  .item .c { font-size: 12px; color: var(--accent-2); }
  mark { background: var(--glow); color: var(--text); border-radius: 3px; padding: 0 2px; }
</style>

<script>
  const q = document.getElementById('q');
  const results = document.getElementById('results');
  const stat = document.getElementById('stat');
  let INDEX = [];

  async function load() {
    const res = await fetch('/search.json');
    INDEX = await res.json();
  }

  function hl(text, term) {
    if (!term) return text;
    const i = text.toLowerCase().indexOf(term.toLowerCase());
    if (i < 0) return text;
    return text.slice(0, i) + '<mark>' + text.slice(i, i + term.length) + '</mark>' + text.slice(i + term.length);
  }

  function render(term) {
    term = term.trim().toLowerCase();
    const list = term
      ? INDEX.filter((n) =>
          (n.title + ' ' + n.summary + ' ' + n.category + ' ' + n.tags.join(' ')).toLowerCase().includes(term)
        )
      : INDEX;
    stat.textContent = term ? `命中 ${list.length} 篇` : `共 ${list.length} 篇`;
    results.innerHTML = list
      .map(
        (n) => `
      <div class="item">
        <a href="${n.url}">${hl(n.title, term)}</a>
        <div class="s">${hl(n.summary, term)}</div>
        <div class="c"># ${n.category} · ${n.date}</div>
      </div>`
      )
      .join('');
  }

  q.addEventListener('input', () => render(q.value));
  load().then(() => render(''));
</script>
