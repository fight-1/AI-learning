---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getNotes, uniqueCategories } from '../../lib/notes';

const notes = await getNotes();
const cats = uniqueCategories(notes).map((c) => ({
  name: c,
  count: notes.filter((n) => n.data.category === c).length,
}));
---

<BaseLayout title="分类 · fight-1">
  <h1>分类</h1>
  <p class="muted">固定书架，共 {cats.length} 个。</p>
  <div class="list">
    {cats.map((c) => (
      <a class="row card" href={`/notes?category=${encodeURIComponent(c.name)}`}>
        <span class="name"># {c.name}</span>
        <span class="num">{c.count} 篇</span>
      </a>
    ))}
  </div>
</BaseLayout>

<style>
  h1 { font-size: 26px; margin: 0 0 6px; }
  .muted { color: var(--muted); margin-top: 0; }
  .list { display: flex; flex-direction: column; gap: 10px; margin-top: 18px; }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 18px;
    color: var(--text);
  }
  .row:hover { text-decoration: none; }
  .name { font-size: 15px; }
  .num { color: var(--muted); font-size: 13px; }
</style>
