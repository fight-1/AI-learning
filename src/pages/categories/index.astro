---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getNotes, uniqueCategories, formatDate } from '../../lib/notes';

const notes = await getNotes();
const MATURITY: Record<string, { label: string; icon: string; cls: string }> = {
  draft: { label: '草稿', icon: '🌱', cls: 'draft' },
  growing: { label: '成长中', icon: '🌿', cls: 'growing' },
  polished: { label: '已打磨', icon: '💎', cls: 'polished' },
};
const cats = uniqueCategories(notes).map((c) => {
  const items = notes.filter((n) => n.data.category === c);
  return { name: c, count: items.length, items };
});
---

<BaseLayout title="分类 · fight-1">
  <div class="page-head">
    <h1>分类</h1>
    <p class="count">共 {cats.length} 个</p>
  </div>
  <p class="page-sub">固定书架，点「展开全部」可就地预览该分类的文章。</p>
  <div class="list">
    {cats.map((c) => (
      <div class="row card" data-collapse="on" data-total={c.count}>
        <a class="cat-head" href={`/notes?category=${encodeURIComponent(c.name)}`}>
          <span class="name"># {c.name}</span>
          <span class="num">{c.count} 篇 →</span>
        </a>
        <ul class="cat-list">
          {c.items.map((n, i) => {
            const mat = MATURITY[n.data.maturity || 'growing'];
            return (
            <li class:list={[{ 'is-extra': i >= 5 }]}>
              <a class="ct" href={`/notes/${n.id}/`} data-astro-prefetch>{n.data.title}</a>
              <span class="cd">{formatDate(n.data.date)}</span>
              <span class="mat-badge" data-mat={mat.cls} title={`成熟度：${mat.label}`}>{mat.icon} {mat.label}</span>
            </li>
          )})}
        </ul>
        {c.count > 5 && (
          <button class="more-btn" type="button" data-expand>展开全部（{c.count} 篇）</button>
        )}
      </div>
    ))}
  </div>
</BaseLayout>

<script>
  import { initExpand } from '../../scripts/expand-list.js';
  initExpand();
</script>

<style>
  .list { display: flex; flex-direction: column; gap: 10px; margin-top: 18px; }
  .row {
    display: flex;
    flex-direction: column;
    padding: 14px 18px;
    color: var(--text);
  }
  .cat-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--text);
  }
  .cat-head:hover { text-decoration: none; }
  .cat-head:hover .name { color: var(--accent); }
  .name { font-size: 15px; transition: color 0.15s; }
  .num { color: var(--muted); font-size: 13px; }
  /* 就地预览的文章列表 */
  .cat-list { list-style: none; margin: 10px 0 0; padding: 0; }
  .cat-list li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 7px 10px;
    border-left: 3px solid transparent;
    border-radius: 0 8px 8px 0;
    transition: background 0.15s, border-color 0.15s;
  }
  .cat-list li:hover,
  .cat-list li:focus-within {
    background: var(--surface-2);
    border-left-color: var(--accent);
  }
  .cat-list .ct { color: var(--text); font-size: 14px; }
  .cat-list .ct:hover { color: var(--accent); text-decoration: none; }
  .cat-list .cd { color: var(--muted); font-size: 12px; white-space: nowrap; }
  /* 成熟度徽章（与文章页/卡片同色系） */
  .cat-list .mat-badge {
    padding: 1px 7px;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--muted);
    font-size: 11px;
    white-space: nowrap;
  }
  .cat-list .mat-badge[data-mat='polished'] { color: var(--accent-color); border-color: var(--accent-color); }
  .cat-list .mat-badge[data-mat='draft'] { opacity: 0.75; font-style: italic; }
  /* 默认只展示前 5 条 */
  [data-collapse='on'] .is-extra { display: none; }
  .more-btn {
    align-self: flex-start;
    margin-top: 10px;
    padding: 6px 14px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--muted);
    font-size: 12px;
    font-family: inherit;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
  }
  .more-btn:hover { color: var(--accent); border-color: var(--accent); }
  .more-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
</style>
