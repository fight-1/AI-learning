---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="收藏 · fight-1">
  <h1>我的收藏</h1>
  <p class="muted">本地收藏，只存在你的浏览器里，不会上传。</p>

  <div class="view-bar" role="group" aria-label="排列切换">
    <button type="button" data-view-btn="grid" class="on" aria-pressed="true" title="网格">▦ 网格</button>
    <button type="button" data-view-btn="list" aria-pressed="false" title="简约列表">☰ 列表</button>
  </div>

  <div id="fav-list" class="grid" data-view="grid"></div>
  <p id="empty" class="muted" hidden>还没有收藏。在任意笔记卡片上点 ☆ 即可加入。</p>
</BaseLayout>

<style>
  h1 { font-size: 26px; margin: 0 0 6px; }
  .muted { color: var(--muted); }

  /* 排列切换条 */
  .view-bar {
    display: flex;
    gap: 6px;
    margin: 18px 0 14px;
  }
  .view-bar button {
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface-2);
    color: var(--muted);
    font-size: 13px;
    font-family: inherit;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .view-bar button.on {
    color: var(--accent-color);
    border-color: var(--accent-color);
    background: color-mix(in srgb, var(--accent) 12%, var(--surface-2));
  }

  /* 网格视图（默认） */
  #fav-list.grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
  }
  #fav-list .item {
    padding: 16px 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  #fav-list .item a {
    color: var(--text);
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
  }
  #fav-list .item a:hover { color: var(--accent); }
  #fav-list .item .s { color: var(--muted); font-size: 13px; }

  /* 简约列表视图 */
  #fav-list.list {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 4px;
  }
  #fav-list.list .item {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 11px 14px;
    border: 1px solid var(--border);
    border-left: 3px solid transparent;
    border-radius: 0 10px 10px 0;
    background: var(--surface);
    transition: border-color 0.15s, background 0.15s;
  }
  #fav-list.list .item:hover {
    border-left-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 6%, var(--surface));
  }
  #fav-list.list .item a {
    font-size: 15px;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1;
  }
  #fav-list.list .item .s { flex-shrink: 0; font-size: 12px; }
  #fav-list.list .item .rm {
    flex-shrink: 0;
    margin-left: 4px;
    border: none;
    background: transparent;
    color: var(--muted);
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
    padding: 2px 6px;
    border-radius: 6px;
  }
  #fav-list.list .item .rm:hover { color: #e5484d; background: color-mix(in srgb, #e5484d 12%, transparent); }

  /* 移除按钮（仅列表视图显示） */
  #fav-list.grid .item .rm { display: none; }

  @media (max-width: 560px) {
    #fav-list.list .item .s { display: none; }
  }
</style>

<script>
  const list = document.getElementById('fav-list') as HTMLDivElement;
  const empty = document.getElementById('empty') as HTMLParagraphElement;
  const btns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-view-btn]'));
  const KEY_VIEW = 'fav-view';

  function setView(view: 'grid' | 'list') {
    list.dataset.view = view;
    localStorage.setItem(KEY_VIEW, view);
    btns.forEach((b) => {
      const on = b.dataset.viewBtn === view;
      b.classList.toggle('on', on);
      b.setAttribute('aria-pressed', String(on));
    });
  }
  btns.forEach((b) => b.addEventListener('click', () => setView(b.dataset.viewBtn as 'grid' | 'list')));
  setView((localStorage.getItem(KEY_VIEW) as 'grid' | 'list') || 'grid');

  function load() {
    const favs: string[] = JSON.parse(localStorage.getItem('favs') || '[]');
    fetch('/search.json')
      .then((r) => r.json())
      .then((idx: any[]) => {
        const items = idx.filter((n) => favs.includes(n.id));
        if (items.length === 0) {
          empty.hidden = false;
          list.innerHTML = '';
          return;
        }
        list.innerHTML = items
          .map(
            (n) => `
        <div class="item">
          <a href="${n.url}">${n.title}</a>
          <div class="s"># ${n.category} · ${n.date}</div>
          <button type="button" class="rm" data-rm="${n.id}" title="取消收藏" aria-label="取消收藏">×</button>
        </div>`
          )
          .join('');
        list.querySelectorAll<HTMLButtonElement>('[data-rm]').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            const id = btn.dataset.rm!;
            const arr = JSON.parse(localStorage.getItem('favs') || '[]').filter((x: string) => x !== id);
            localStorage.setItem('favs', JSON.stringify(arr));
            btn.closest('.item')?.remove();
            if (list.children.length === 0) { empty.hidden = false; }
          });
        });
      });
  }
  load();
</script>
