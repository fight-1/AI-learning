---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../lib/notes';

const drafts = (await getCollection('notes', ({ data }) => data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title="草稿 · fight-1" noindex={true}>
  <h1>📝 草稿舱</h1>
  <p class="muted">写作中的笔记（frontmatter 标记 <code>draft: true</code>），尚未发布。此页仅作者可见，已对搜索引擎 noindex。</p>

  {drafts.length === 0 ? (
    <p class="empty">暂无草稿，所有笔记均已发布 ✓</p>
  ) : (
    <ul class="draft-list">
      {drafts.map((d) => (
        <li class="draft-item">
          <div class="draft-meta">
            <span class="chip">{d.data.category}</span>
            <time>{formatDate(d.data.date)}</time>
            <span class="draft-flag">未发布</span>
          </div>
          <h3 class="draft-title">{d.data.title}</h3>
          <p class="draft-sum">{d.data.summary}</p>
          <div class="draft-tags">
            {d.data.tags.map((t) => <span class="chip">#{t}</span>)}
          </div>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>

<style>
  h1 { font-size: 26px; margin: 0 0 6px; }
  .muted { color: var(--muted); margin-top: 0; }
  .muted code { color: var(--accent); background: var(--surface-2); padding: 0.1em 0.4em; border-radius: 6px; }
  .empty { color: var(--muted); margin-top: 20px; }
  .draft-list { list-style: none; padding: 0; margin: 18px 0 0; display: grid; gap: 14px; }
  .draft-item {
    padding: 16px 18px; border: 1px dashed var(--border); border-radius: var(--radius);
    background: var(--surface);
  }
  .draft-meta { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--muted); margin-bottom: 8px; }
  .draft-flag {
    padding: 1px 8px; border-radius: 999px; border: 1px solid var(--accent-2);
    color: var(--accent-2); font-size: 11px;
  }
  .draft-title { margin: 0 0 6px; font-size: 17px; font-weight: 600; color: var(--text); }
  .draft-sum { margin: 0 0 12px; font-size: 13px; color: var(--muted); line-height: 1.6; }
  .draft-tags { display: flex; flex-wrap: wrap; gap: 6px; }
</style>
