---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getNotes, uniqueCategories } from '../lib/notes';

const notes = (await getNotes()).slice(0, 8);
const cats = uniqueCategories(notes);
const fmt = (d) => new Date(d).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title="订阅本站 · fight-1 的 AI 学习笔记" description="通过 RSS 订阅 fight-1 的 AI 学习笔记更新">
  <section class="sub-hero">
    <p class="kicker">RSS · SUBSCRIBE</p>
    <h1>订阅本站</h1>
    <p class="sub">
      RSS 是一种「更新自动送达」的订阅方式：把下面的订阅地址添加到任意 RSS 阅读器，
      新文章发布后会自动出现在你的阅读器里，无需反复刷新网站、也不被算法打扰。
    </p>
  </section>

  <section class="feed-card" data-reveal>
    <div class="feed-row">
      <span class="feed-icon" aria-hidden="true">📡</span>
      <code class="feed-url" id="feed-url">/rss.xml</code>
      <button class="sub-copy" id="sub-copy-btn" type="button">复制地址</button>
    </div>
    <p class="feed-note">
      阅读器里粘贴 <code>/rss.xml</code>（或点击复制按钮获取完整地址）。常用阅读器：
      Feedly · Inoreader · NetNewsWire · Folo · TinyTinyRSS。
    </p>
    <a class="raw-link" href="/rss.xml">直接查看订阅源 XML →</a>
  </section>

  <section class="block" data-reveal>
    <div class="block-head"><h2>按分类订阅</h2></div>
    <ul class="cats">
      {cats.map((c) => (
        <li>
          <a href={`/rss.xml?category=${encodeURIComponent(c)}`}>{c}</a>
          <a class="raw" href={`/rss.xml?category=${encodeURIComponent(c)}`}>XML</a>
        </li>
      ))}
    </ul>
  </section>

  <section class="block" data-reveal>
    <div class="block-head"><h2>最近更新</h2></div>
    <ul class="recent">
      {notes.map((n) => (
        <li>
          <a href={`/notes/${n.id}/`}>{n.data.title}</a>
          <span class="meta">{fmt(n.data.date)} · {n.data.category}</span>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .sub-hero {
    text-align: center;
    padding: 44px 0 28px;
  }
  .kicker {
    letter-spacing: 4px;
    font-size: 12px;
    color: var(--muted);
    margin: 0 0 12px;
  }
  h1 {
    font-size: clamp(26px, 5vw, 40px);
    margin: 0 0 12px;
  }
  .sub {
    color: var(--muted);
    max-width: 560px;
    margin: 0 auto;
    font-size: 14px;
  }
  .feed-card {
    max-width: 640px;
    margin: 12px auto 8px;
    padding: 22px 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .feed-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .feed-icon { font-size: 18px; }
  .feed-url {
    flex: 1;
    font-size: 14px;
    padding: 8px 12px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg, transparent);
    overflow-x: auto;
    white-space: nowrap;
  }
  .sub-copy {
    padding: 8px 14px;
    font-size: 13px;
    border: 1px solid var(--accent);
    border-radius: 8px;
    background: var(--accent);
    color: #04121a;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
  }
  .sub-copy.ok { filter: brightness(1.15); }
  .feed-note {
    font-size: 12.5px;
    color: var(--muted);
    margin: 12px 0 10px;
  }
  .raw-link {
    font-size: 13px;
    color: var(--accent);
  }
  .block {
    max-width: 640px;
    margin: 32px auto 0;
  }
  .block-head h2 {
    font-size: 18px;
    margin: 0 0 12px;
  }
  .recent {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .recent li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    padding: 10px 2px;
    border-bottom: 1px dashed var(--border);
  }
  .recent a {
    color: var(--text);
    font-size: 14px;
  }
  .recent a:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .cats { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .cats li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
  }
  .cats a { color: var(--text); font-size: 13px; }
  .cats a:hover { color: var(--accent); text-decoration: none; }
  .cats .raw { color: var(--muted); font-size: 11px; }
  .cats .raw:hover { color: var(--accent-2); }
  .meta {
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
  }
</style>

<script>
  const btn = document.getElementById('sub-copy-btn');
  const code = document.getElementById('feed-url');
  if (btn && code) {
    const full = new URL('/rss.xml', location.origin).toString();
    code.textContent = full;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(full);
        btn.textContent = '已复制 ✓';
        btn.classList.add('ok');
        setTimeout(() => { btn.textContent = '复制地址'; btn.classList.remove('ok'); }, 1800);
      } catch {
        btn.textContent = '复制失败';
        setTimeout(() => (btn.textContent = '复制地址'), 1800);
      }
    });
  }
</script>
