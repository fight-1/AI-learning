---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getNotes, uniqueCategories } from '../lib/notes';

const notes = (await getNotes()).slice(0, 8);
const cats = uniqueCategories(notes);
const fmt = (d) => new Date(d).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title="订阅本站 · fight-1 的 AI 学习笔记" description="通过 RSS 订阅 fight-1 的 AI 学习笔记更新">
  <section class="sub-hero">
    <p class="kicker">RSS · SUBSCRIBE</p>
    <h1>订阅本站</h1>
    <p class="sub">
      RSS 是一种「更新自动送达」的订阅方式：把下面的订阅地址添加到任意 RSS 阅读器，
      新文章发布后会自动出现在你的阅读器里，无需反复刷新网站、也不被算法打扰。
    </p>
  </section>

  <section class="feed-card" data-reveal>
    <div class="feed-row">
      <span class="feed-icon" aria-hidden="true">📡</span>
      <code class="feed-url" id="feed-url">/rss.xml</code>
      <button class="sub-copy" id="sub-copy-btn" type="button">复制地址</button>
    </div>
    <p class="feed-note">
      阅读器里粘贴 <code>/rss.xml</code>（或点击复制按钮获取完整地址）。常用阅读器：
      Feedly · Inoreader · NetNewsWire · Folo · TinyTinyRSS。
    </p>
    <a class="raw-link" href="/rss.xml">直接查看订阅源 XML →</a>
  </section>

  <section class="block" data-reveal>
    <div class="block-head"><h2>按分类订阅</h2></div>
    <ul class="cats">
      {cats.map((c) => (
        <li>
          <a href={`/rss.xml?category=${encodeURIComponent(c)}`}>{c}</a>
          <a class="raw" href={`/rss.xml?category=${encodeURIComponent(c)}`}>XML</a>
        </li>
      ))}
    </ul>
  </section>

  <section class="block mail-card" data-reveal>
    <div class="block-head"><h2>邮件订阅</h2></div>
    <p class="sub">
      想让新文章直接进邮箱？<strong class="warn">目前是虚拟邮箱占位</strong>：本站是纯静态站点，
      尚未接入真实邮件服务，提交只会唤起你的邮件客户端。接入 Buttondown / Mailchimp / Formspree 后，
      把脚本里的 <code>SUBSCRIBE_ENDPOINT</code> 换成真实地址即可真正生效。
    </p>
    <form class="mail-form" id="mail-form" novalidate>
      <input
        type="email"
        id="mail-input"
        name="email"
        required
        placeholder="you@example.com"
        aria-label="邮箱地址"
        autocomplete="email"
      />
      <button type="submit" class="btn btn-primary">订阅</button>
    </form>
    <p class="mail-note">
      虚拟邮箱：<code id="virtual-mail">subscribe@fight-1.example.com</code>
      <button class="sub-copy" id="mail-copy-btn" type="button">复制</button>
    </p>
    <p class="mail-msg" id="mail-msg" role="status" aria-live="polite"></p>
  </section>

  <section class="block" data-reveal>
    <div class="block-head"><h2>最近更新</h2></div>
    <ul class="recent">
      {notes.map((n) => (
        <li>
          <a href={`/notes/${n.id}/`}>{n.data.title}</a>
          <span class="meta">{fmt(n.data.date)} · {n.data.category}</span>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .sub-hero {
    text-align: center;
    padding: 44px 0 28px;
  }
  .kicker {
    letter-spacing: 4px;
    font-size: 12px;
    color: var(--muted);
    margin: 0 0 12px;
  }
  h1 {
    font-size: clamp(26px, 5vw, 40px);
    margin: 0 0 12px;
  }
  .sub {
    color: var(--muted);
    max-width: 560px;
    margin: 0 auto;
    font-size: 14px;
  }
  .feed-card {
    max-width: 640px;
    margin: 12px auto 8px;
    padding: 22px 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .feed-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .feed-icon { font-size: 18px; }
  .feed-url {
    flex: 1;
    font-size: 14px;
    padding: 8px 12px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg, transparent);
    overflow-x: auto;
    white-space: nowrap;
  }
  .sub-copy {
    padding: 8px 14px;
    font-size: 13px;
    border: 1px solid var(--accent);
    border-radius: 8px;
    background: var(--accent);
    color: #04121a;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
  }
  .sub-copy.ok { filter: brightness(1.15); }
  .feed-note {
    font-size: 12.5px;
    color: var(--muted);
    margin: 12px 0 10px;
  }
  .raw-link {
    font-size: 13px;
    color: var(--accent);
  }
  .block {
    max-width: 640px;
    margin: 32px auto 0;
  }
  .block-head h2 {
    font-size: 18px;
    margin: 0 0 12px;
  }
  .recent {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .recent li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    padding: 10px 2px;
    border-bottom: 1px dashed var(--border);
  }
  .recent a {
    color: var(--text);
    font-size: 14px;
  }
  .recent a:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .cats { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .cats li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
  }
  .cats a { color: var(--text); font-size: 13px; }
  .cats a:hover { color: var(--accent); text-decoration: none; }
  .cats .raw { color: var(--muted); font-size: 11px; }
  .cats .raw:hover { color: var(--accent-2); }
  .meta {
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
  }
  /* 邮件订阅（虚拟邮箱占位） */
  .mail-card .warn { color: var(--accent); }
  .mail-form {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 10px;
  }
  .mail-form input {
    flex: 1 1 220px;
    padding: 10px 14px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface-2);
    color: var(--text);
    font-size: 14px;
    font-family: inherit;
  }
  .mail-form input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 10px 20px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    font-size: 14px;
    font-family: inherit;
    cursor: pointer;
  }
  .btn-primary {
    background: var(--accent);
    color: #04121a;
    border-color: var(--accent);
    font-weight: 600;
  }
  .btn:hover { border-color: var(--accent); }
  .mail-note {
    margin: 10px 0 0;
    font-size: 12px;
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .mail-msg {
    margin: 8px 0 0;
    font-size: 12px;
    color: var(--accent);
    min-height: 16px;
  }
</style>

<script>
  const btn = document.getElementById('sub-copy-btn');
  const code = document.getElementById('feed-url');
  if (btn && code) {
    const full = new URL('/rss.xml', location.origin).toString();
    code.textContent = full;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(full);
        btn.textContent = '已复制 ✓';
        btn.classList.add('ok');
        setTimeout(() => { btn.textContent = '复制地址'; btn.classList.remove('ok'); }, 1800);
      } catch {
        btn.textContent = '复制失败';
        setTimeout(() => (btn.textContent = '复制地址'), 1800);
      }
    });
  }

  /* 邮件订阅：纯静态站点暂无后端，先用虚拟邮箱占位。
     接入 Buttondown / Mailchimp / Formspree 后，把 SUBSCRIBE_ENDPOINT 换成其表单地址即可真正生效。 */
  const SUBSCRIBE_ENDPOINT = '';
  const VIRTUAL_MAIL = 'subscribe@fight-1.example.com';
  const mailForm = document.getElementById('mail-form');
  const mailInput = document.getElementById('mail-input');
  const mailMsg = document.getElementById('mail-msg');
  if (mailForm && mailInput && mailMsg) {
    mailForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (mailInput.value || '').trim();
      if (!email) {
        mailMsg.textContent = '请先填写邮箱地址。';
        return;
      }
      if (SUBSCRIBE_ENDPOINT) {
        try {
          const res = await fetch(SUBSCRIBE_ENDPOINT, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email }),
          });
          mailMsg.textContent = res.ok ? '订阅成功，请到邮箱确认。' : '订阅失败，请稍后再试。';
        } catch {
          mailMsg.textContent = '订阅失败，请稍后再试。';
        }
        return;
      }
      // 未接入真实服务：提示 + 唤起邮件客户端（收件人为虚拟邮箱，仅占位）
      mailMsg.textContent = '尚未接入真实邮件服务，已尝试唤起你的邮件客户端（收件人为虚拟邮箱，仅作占位）。';
      const subject = encodeURIComponent('订阅 fight-1 的 AI 学习笔记');
      const body = encodeURIComponent('我的邮箱：' + email);
      window.location.href = `mailto:${VIRTUAL_MAIL}?subject=${subject}&body=${body}`;
    });
  }
  const mailCopy = document.getElementById('mail-copy-btn');
  const vmail = document.getElementById('virtual-mail');
  if (mailCopy && vmail) {
    mailCopy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(vmail.textContent.trim());
        mailCopy.textContent = '已复制 ✓';
        setTimeout(() => (mailCopy.textContent = '复制'), 1800);
      } catch {
        mailCopy.textContent = '复制失败';
        setTimeout(() => (mailCopy.textContent = '复制'), 1800);
      }
    });
  }
</script>
