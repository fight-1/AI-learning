<script>
  const bar = document.getElementById('progress');
  const art = document.querySelector('.detail');
  function update() {
    if (!bar || !art) return;
    const h = art.getBoundingClientRect().height - window.innerHeight;
    const scrolled = Math.min(Math.max(-art.getBoundingClientRect().top + 80, 0), h);
    const pct = h > 0 ? (scrolled / h) * 100 : 0;
    bar.style.width = pct + '%';
  }
  window.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update);
  update();
</script>

<script>
  // 分享栏：复制链接 / 微博 / X / 微信二维码
  (function () {
    const bar = document.querySelector('.share-bar');
    if (!bar) return;
    const url = location.href;
    const title = document.title;
    const enc = encodeURIComponent;

    const copyText = async (t) => {
      try {
        await navigator.clipboard.writeText(t);
        return true;
      } catch (e) {
        const ta = document.createElement('textarea');
        ta.value = t;
        ta.style.position = 'fixed';
        ta.style.top = '-9999px';
        document.body.appendChild(ta);
        ta.focus();
        ta.select();
        let ok = false;
        try { ok = document.execCommand('copy'); } catch (_) {}
        ta.remove();
        return ok;
      }
    };

    const toast = (msg) => {
      let t = document.querySelector('.share-toast');
      if (!t) {
        t = document.createElement('div');
        t.className = 'share-toast';
        document.body.appendChild(t);
      }
      t.textContent = msg;
      t.classList.add('show');
      clearTimeout(t._timer);
      t._timer = setTimeout(() => t.classList.remove('show'), 1800);
    };

    const openWechat = (u) => {
      const overlay = document.createElement('div');
      overlay.className = 'qr-overlay';
      overlay.innerHTML =
        '<div class="qr-box">' +
        '<button class="qr-close" aria-label="关闭">×</button>' +
        '<p class="qr-tip">扫码或复制链接，分享到微信</p>' +
        '<img class="qr-img" alt="微信分享二维码" src="https://api.qrserver.com/v1/create-qr-code/?size=220x220&margin=8&data=' + enc(u) + '">' +
        '<p class="qr-url" style="display:none"></p>' +
        '</div>';
      const img = overlay.querySelector('.qr-img');
      const urlP = overlay.querySelector('.qr-url');
      urlP.textContent = u;
      img.addEventListener('error', () => {
        img.style.display = 'none';
        urlP.style.display = 'block';
      });
      overlay.addEventListener('click', (e) => {
        if (e.target === overlay || e.target.classList.contains('qr-close')) overlay.remove();
      });
      document.body.appendChild(overlay);
    };

    bar.querySelectorAll('.share-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const type = btn.dataset.share;
        if (type === 'copy') {
          const ok = await copyText(url);
          toast(ok ? '链接已复制 ✓' : '复制失败，请手动复制');
          if (ok) { btn.classList.add('copied'); setTimeout(() => btn.classList.remove('copied'), 1400); }
        } else if (type === 'weibo') {
          window.open('https://service.weibo.com/share/share.php?url=' + enc(url) + '&title=' + enc(title), '_blank', 'noopener');
        } else if (type === 'twitter') {
          window.open('https://twitter.com/intent/tweet?url=' + enc(url) + '&text=' + enc(title), '_blank', 'noopener');
        } else if (type === 'wechat') {
          openWechat(url);
        } else if (type === 'print') {
          // 打印 / 另存为 PDF：global.css 的 @media print 已隐藏背景/导航/侧栏
          window.print();
        } else if (type === 'offline') {
          // 主动写入 Service Worker 缓存，确保断网后仍可读本篇
          (async () => {
            try {
              const cache = await caches.open('offline-user');
              await cache.add(location.pathname);
              toast('已保存到离线 ✓');
              btn.classList.add('copied');
              setTimeout(() => btn.classList.remove('copied'), 1400);
            } catch (e) {
              toast('保存失败，可能不支持离线缓存');
            }
          })();
        }
      });
    });
  })();
</script>

<script>
  // 锚点一键复制：给正文 h2/h3 生成 id + 悬浮 # 按钮
  (function () {
    const content = document.querySelector('.content');
    if (!content) return;
    const heads = content.querySelectorAll('h2, h3');
    let n = 0;
    const slugify = (t) =>
      t.trim().toLowerCase().replace(/[^\w一-龥]+/g, '-').replace(/^-+|-+$/g, '') || 'h';
    heads.forEach((h) => {
      if (!h.id) h.id = slugify(h.textContent) + '-' + ++n;
      h.classList.add('has-anchor');
      const a = document.createElement('a');
      a.className = 'anchor-link';
      a.href = '#' + h.id;
      a.textContent = '#';
      a.setAttribute('aria-label', '复制锚点链接');
      a.addEventListener('click', (e) => {
        e.preventDefault();
        const link = location.origin + location.pathname + '#' + h.id;
        if (navigator.clipboard) navigator.clipboard.writeText(link).then(() => {
          a.textContent = '✓';
          setTimeout(() => (a.textContent = '#'), 1200);
        }).catch(() => {});
        history.replaceState(null, '', '#' + h.id);
      });
      h.appendChild(a);
    });

    // 专注阅读模式按钮（文章页）
    const fb = document.getElementById('focus-toggle');
    if (fb) {
      const sync = () => {
        const on = document.documentElement.getAttribute('data-focus') === 'on';
        fb.classList.toggle('on', on);
        fb.textContent = on ? '退出专注' : '专注阅读';
      };
      sync();
      fb.addEventListener('click', () => {
        window.__setFocus(document.documentElement.getAttribute('data-focus') !== 'on');
        sync();
      });
      new MutationObserver(sync).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-focus'],
      });
    }

    // 专注阅读正文对齐切换（居左 ↔ 居中，默认居左）
    const fab = document.getElementById('focus-align-toggle');
    if (fab) {
      const setAlign = (v) => {
        if (window.__setFocusAlign) window.__setFocusAlign(v);
        else {
          const a = v === 'center' ? 'center' : 'left';
          document.documentElement.setAttribute('data-focus-align', a);
          try { localStorage.setItem('focus_align', a); } catch (e) {}
        }
      };
      const getAlign = () =>
        document.documentElement.getAttribute('data-focus-align') ||
        (localStorage.getItem('focus_align') === 'center' ? 'center' : 'left');
      const syncAlign = () => {
        const a = getAlign();
        fab.textContent = a === 'center' ? '正文居中' : '正文居左';
        fab.classList.toggle('on', a === 'center');
      };
      syncAlign();
      fab.addEventListener('click', () => {
        setAlign(getAlign() === 'center' ? 'left' : 'center');
        syncAlign();
      });
    }
  })();
</script>
