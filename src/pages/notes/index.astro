---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteCard from '../../components/NoteCard.astro';
import { getNotes, uniqueCategories, uniqueTags } from '../../lib/notes';

const notes = await getNotes();
const cats = uniqueCategories(notes);
const tags = uniqueTags(notes);

const category = Astro.url.searchParams.get('category');
const tag = Astro.url.searchParams.get('tag');

let filtered = notes;
let heading = '全部笔记';
if (category) {
  filtered = notes.filter((n) => n.data.category === category);
  heading = `分类：${category}`;
} else if (tag) {
  filtered = notes.filter((n) => n.data.tags.includes(tag));
  heading = `标签：#${tag}`;
}
---

<BaseLayout title={`${heading} · fight-1`}>
  <div class="page-head">
    <h1>{heading}</h1>
    <p class="count">{filtered.length} 篇</p>
    <a class="clear-filter" href="/notes" data-clear-filter hidden>✕ 查看全部笔记</a>
  </div>

  <div class="filters">
    <div class="filter-row">
      <span class="fl">分类</span>
      <a class:list={['chip', { on: !category && !tag }]} href="/notes">全部</a>
      {cats.map((c) => (
        <a class:list={['chip', { on: category === c }]} href={`/notes?category=${encodeURIComponent(c)}`}># {c}</a>
      ))}
    </div>
    <div class="filter-row">
      <span class="fl">标签</span>
      {tags.slice(0, 16).map((t) => (
        <a class:list={['chip', { on: tag === t }]} href={`/notes?tag=${encodeURIComponent(t)}`}># {t}</a>
      ))}
    </div>
  </div>

  <div class="stage-bar">
    <span class="fl">舞台</span>
    <button class="stage-btn active" data-stage="grid">网格</button>
    <button class="stage-btn" data-stage="depth">纵深叠排</button>
    <button class="stage-btn" data-stage="fan">扇形</button>
    <button class="stage-btn" data-stage="cylinder">圆柱</button>
    <button class="stage-btn" data-stage="sphere">球面</button>
    <button class="stage-btn" data-stage="spiral">螺旋</button>
    <button class="stage-btn" data-stage="wave">波浪矩阵</button>
  </div>

  <div class="grid stage-view">
    {filtered.map((n) => <NoteCard note={n} />)}
  </div>

  {filtered.length === 0 && <p class="empty">没有匹配的笔记。</p>}
</BaseLayout>

<style>
  .page-head {
    position: sticky;
    top: 64px;
    z-index: 10;
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 16px;
    padding: 10px 14px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    backdrop-filter: blur(8px);
  }
  .page-head h1 {
    font-size: 22px;
    margin: 0;
  }
  .page-head .count {
    color: var(--muted);
    font-size: 13px;
    margin: 0;
  }
  .clear-filter {
    margin-left: auto;
    padding: 4px 12px;
    border-radius: 999px;
    border: 1px solid var(--accent-color);
    background: transparent;
    color: var(--accent-color);
    font-size: 12px;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }
  .clear-filter:hover {
    background: var(--accent-color);
    color: var(--bg);
  }
  .filters {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    margin-bottom: 22px;
  }
  .filter-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .fl {
    font-size: 12px;
    color: var(--muted);
    width: 32px;
    flex: none;
  }
  .chip.on {
    color: var(--accent);
    border-color: var(--accent);
  }
  .stage-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
  }
  .empty {
    color: var(--muted);
  }
</style>

<script>
  import { initStages } from '../../scripts/stages.js';
  const view = document.querySelector('.stage-view');
  const allCards = Array.from(view.querySelectorAll('.stage-card'));
  const bar = document.querySelector('.stage-bar');
  const h1 = document.querySelector('.page-head h1');
  const countEl = document.querySelector('.page-head .count');
  // 客户端筛选：静态页构建期 searchParams 无值，运行时根据 URL 过滤
  const params = new URLSearchParams(location.search);
  const tag = params.get('tag');
  const cat = params.get('category');
  let visible = allCards;
  if (cat) {
    visible = allCards.filter((c) => c.dataset.category === cat);
    h1.textContent = `分类：${cat}`;
  } else if (tag) {
    visible = allCards.filter((c) => (c.dataset.tags || '').split('|').includes(tag));
    h1.textContent = `标签：#${tag}`;
  }
  // 移除不匹配卡片
  allCards.forEach((c) => { if (!visible.includes(c)) c.remove(); });
  if (countEl) countEl.textContent = `${visible.length} 篇`;
  // 显示清除筛选入口（HTML 默认 hidden，仅运行时按 URL 解开）
  const cf = document.querySelector('[data-clear-filter]');
  if (cf) cf.hidden = !(cat || tag);
  // 高亮当前筛选 chip
  const chips = document.querySelectorAll('.filter-row .chip');
  chips.forEach((a) => a.classList.remove('on'));
  if (cat) {
    chips.forEach((a) => {
      if (a.getAttribute('href') === '/notes?category=' + encodeURIComponent(cat)) a.classList.add('on');
    });
  } else if (tag) {
    chips.forEach((a) => {
      if (a.getAttribute('href') === '/notes?tag=' + encodeURIComponent(tag)) a.classList.add('on');
    });
  } else {
    chips.forEach((a) => { if (a.getAttribute('href') === '/notes') a.classList.add('on'); });
  }
  initStages(view, visible, bar);

  // 返回定位记忆：点进具体笔记后再点「返回」，应回到离开前的滚动位置与舞台模式。
  // 否则重载后 initStages 重置为网格模式，浏览器原生恢复会落到错误位置。
  const POSKEY = 'notes:pos:' + location.pathname + location.search;
  try { history.scrollRestoration = 'manual'; } catch (e) {}
  function savePos() {
    try {
      const b = bar.querySelector('.stage-btn.active');
      sessionStorage.setItem(POSKEY, JSON.stringify({ y: window.scrollY, m: b ? b.dataset.stage : 'grid' }));
    } catch (e) {}
  }
  // 离开 /notes（含点进笔记、切筛选）时记录；beforeunload 兜底
  window.addEventListener('pagehide', savePos);
  window.addEventListener('beforeunload', savePos);
  // 切换舞台模式即时记模式（稍等 class 更新）
  bar.addEventListener('click', () => setTimeout(savePos, 60));
  function restorePos() {
    let s = null;
    try { s = JSON.parse(sessionStorage.getItem(POSKEY) || 'null'); } catch (e) {}
    if (!s) return;
    // 先还原舞台模式（不同模式高度不同），再恢复滚动
    if (s.m && s.m !== 'grid') {
      const btn = bar.querySelector(`[data-stage="${s.m}"]`);
      if (btn) btn.click(); // 程序化点击 isTrusted=false，不触发自动滚动
    }
    window.scrollTo({ top: s.y || 0, behavior: 'auto' });
  }
  // 等布局稳定后恢复（grid 自然高度 / fan·depth 同步高度 / 动态模式已设高度）
  requestAnimationFrame(() => requestAnimationFrame(restorePos));
</script>
