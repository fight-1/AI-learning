---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteCard from '../../components/NoteCard.astro';
import { getNotes, uniqueCategories, uniqueTags } from '../../lib/notes';

const notes = await getNotes();
const cats = uniqueCategories(notes);
const tags = uniqueTags(notes);

const category = Astro.url.searchParams.get('category');
const tag = Astro.url.searchParams.get('tag');

let filtered = notes;
let heading = '全部笔记';
if (category) {
  filtered = notes.filter((n) => n.data.category === category);
  heading = `分类：${category}`;
} else if (tag) {
  filtered = notes.filter((n) => n.data.tags.includes(tag));
  heading = `标签：#${tag}`;
}
---

<BaseLayout title={`${heading} · fight-1`}>
  <div class="page-head">
    <h1>{heading}</h1>
    <span class="count" id="note-count">{filtered.length} 篇</span>
    <div class="actions">
      <a class="chip" id="clear-filter" href="/notes" data-clear-filter hidden>✕ 查看全部</a>
    </div>
  </div>

  <div class="filters">
    <div class="filter-row">
      <span class="fl">分类</span>
      <a class:list={['chip', { on: !category && !tag }]} href="/notes">全部</a>
      {cats.map((c) => (
        <a class:list={['chip', { on: category === c }]} href={`/notes?category=${encodeURIComponent(c)}`}># {c}</a>
      ))}
    </div>
    <div class="filter-row">
      <span class="fl">标签</span>
      {tags.slice(0, 16).map((t) => (
        <a class:list={['chip', { on: tag === t }]} href={`/notes?tag=${encodeURIComponent(t)}`}># {t}</a>
      ))}
    </div>
  </div>

  <div class="view-bar" role="group" aria-label="排列切换">
    <button type="button" data-view-btn="grid" class="on" aria-pressed="true" title="网格">▦ 网格</button>
    <button type="button" data-view-btn="list" aria-pressed="false" title="简约列表">☰ 列表</button>
  </div>

  <div class="stage-bar" id="stage-bar">
    <span class="fl">舞台</span>
    <button class="stage-btn is-active" data-stage="grid">网格</button>
    <button class="stage-btn" data-stage="depth">纵深叠排</button>
    <button class="stage-btn" data-stage="fan">扇形</button>
    <button class="stage-btn" data-stage="cylinder">圆柱</button>
    <button class="stage-btn" data-stage="sphere">球面</button>
    <button class="stage-btn" data-stage="spiral">螺旋</button>
    <button class="stage-btn" data-stage="wave">波浪矩阵</button>
  </div>

  <div class="stage-view grid" id="notes-view" data-view="grid">
    {filtered.map((n) => <NoteCard note={n} />)}
  </div>

  <p id="empty" class="empty-box" hidden>
    <span class="emoji">🌑</span>
    <span class="eb-t">没有匹配的笔记</span>
  </p>
</BaseLayout>

<style>
  .filters {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    margin-bottom: 14px;
  }
  .filter-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .fl {
    font-size: 12px;
    color: var(--muted);
    width: 32px;
    flex: none;
  }
  .chip.on {
    color: var(--accent-color);
    border-color: var(--accent-color);
    background: color-mix(in srgb, var(--accent) 14%, var(--surface-2));
  }
  .stage-bar .fl { margin-right: 2px; }
  #notes-view {
    position: relative;
    min-height: 60vh;
  }
  #notes-view.grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
  }
  #notes-view.list {
    display: flex;
    flex-direction: column;
    gap: 4px;
    perspective: none;
    transform-style: flat;
  }
  /* 列表项 */
  #notes-view.list .list-item {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 14px;
    padding: 11px 14px;
    border: 1px solid var(--border);
    border-left: 3px solid transparent;
    border-radius: 0 10px 10px 0;
    background: var(--surface);
    transition: background 0.15s, border-color 0.15s;
  }
  #notes-view.list .list-item:hover {
    background: color-mix(in srgb, var(--accent) 6%, var(--surface));
    border-left-color: var(--accent);
  }
  #notes-view.list .list-item a {
    color: var(--text);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  #notes-view.list .list-item a:hover { color: var(--accent); }
  #notes-view.list .li-meta { color: var(--muted); font-size: 12px; white-space: nowrap; }
  #notes-view.list .li-mat { font-size: 11px; }
  @media (max-width: 560px) {
    #notes-view.list .list-item { grid-template-columns: 1fr auto; }
    #notes-view.list .li-mat { display: none; }
  }
</style>

<script>
  import { initStages } from '../../scripts/stages.js';

  const viewBox = document.getElementById('notes-view') as HTMLDivElement;
  const stageBar = document.getElementById('stage-bar') as HTMLDivElement;
  const h1 = document.querySelector('.page-head h1') as HTMLHeadingElement;
  const countEl = document.getElementById('note-count') as HTMLSpanElement;
  const clearA = document.getElementById('clear-filter') as HTMLAnchorElement;
  const empty = document.getElementById('empty') as HTMLParagraphElement;
  const btns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-view-btn]'));
  const allCards = Array.from(viewBox.querySelectorAll<HTMLElement>('.stage-card'));
  const KEY_VIEW = 'notes-view';
  const POSKEY = 'notes:pos:' + location.pathname + location.search;

  // 构建列表项 HTML（服务端已渲染网格，列表由客户端切换生成）
  const listData = allCards.map((card) => ({
    id: card.dataset.id || '',
    title: card.querySelector('.note-title')?.textContent || '',
    summary: card.querySelector('.note-sum')?.textContent || '',
    category: card.dataset.category || '',
    tags: (card.dataset.tags || '').split('|').filter(Boolean),
    date: card.querySelector('.note-meta time')?.textContent || '',
    maturity: card.querySelector('.mat-badge')?.getAttribute('data-mat') || 'growing',
    url: card.closest('a')?.getAttribute('href') || '/notes/' + (card.dataset.id || ''),
  }));

  const MATURITY: Record<string, { label: string; icon: string }> = {
    draft: { label: '草稿', icon: '🌱' },
    growing: { label: '成长中', icon: '🌿' },
    polished: { label: '已打磨', icon: '💎' },
  };

  const params = new URLSearchParams(location.search);
  const tag = params.get('tag');
  const cat = params.get('category');
  let visible = allCards;
  if (cat) {
    visible = allCards.filter((c) => c.dataset.category === cat);
    h1.textContent = `分类：${cat}`;
  } else if (tag) {
    visible = allCards.filter((c) => (c.dataset.tags || '').split('|').includes(tag));
    h1.textContent = `标签：#${tag}`;
  }
  allCards.forEach((c) => { if (!visible.includes(c)) c.remove(); });
  if (countEl) countEl.textContent = `${visible.length} 篇`;
  if (empty) empty.hidden = visible.length > 0;
  if (clearA) clearA.hidden = !(cat || tag);

  // 高亮当前筛选 chip
  const chips = document.querySelectorAll('.filter-row .chip');
  chips.forEach((a) => a.classList.remove('on'));
  if (cat) {
    chips.forEach((a) => {
      if (a.getAttribute('href') === '/notes?category=' + encodeURIComponent(cat)) a.classList.add('on');
    });
  } else if (tag) {
    chips.forEach((a) => {
      if (a.getAttribute('href') === '/notes?tag=' + encodeURIComponent(tag)) a.classList.add('on');
    });
  } else {
    chips.forEach((a) => { if (a.getAttribute('href') === '/notes') a.classList.add('on'); });
  }

  // 舞台初始化（只在网格视图需要）
  initStages(viewBox, visible, stageBar);

  function renderList() {
    viewBox.innerHTML = listData
      .filter((d) => visible.some((c) => c.dataset.id === d.id))
      .map((d) => {
        const m = MATURITY[d.maturity] || MATURITY.growing;
        return `<article class="list-item" data-id="${d.id}">
          <a href="${d.url}" data-astro-prefetch title="${d.title}">${d.title}</a>
          <span class="li-meta"># ${d.category} · ${d.date}</span>
          <span class="chip li-mat" data-mat="${d.maturity}">${m.icon} ${m.label}</span>
        </article>`;
      })
      .join('');
  }

  function setView(view: 'grid' | 'list') {
    viewBox.dataset.view = view;
    localStorage.setItem(KEY_VIEW, view);
    btns.forEach((b) => {
      const on = b.dataset.viewBtn === view;
      b.classList.toggle('on', on);
      b.setAttribute('aria-pressed', String(on));
    });

    if (view === 'list') {
      // 先确保舞台回到 grid（清理动态模式可能挂着的逐帧订阅），再清空为列表
      const gridBtn = stageBar.querySelector<HTMLButtonElement>('[data-stage="grid"]');
      if (gridBtn && !gridBtn.classList.contains('is-active')) gridBtn.click();
      stageBar.hidden = true;
      renderList();
    } else {
      stageBar.hidden = false;
      // 还原网格 DOM（保留原始卡片）
      viewBox.innerHTML = '';
      allCards.forEach((c) => { if (visible.includes(c)) viewBox.appendChild(c); });
      // 恢复当前舞台模式
      const active = stageBar.querySelector<HTMLButtonElement>('.is-active');
      if (active) active.click();
    }
  }

  btns.forEach((b) => b.addEventListener('click', () => setView(b.dataset.viewBtn as 'grid' | 'list')));

  // 返回定位记忆
  try { history.scrollRestoration = 'manual'; } catch (e) {}
  function savePos() {
    try {
      const mode = viewBox.dataset.view === 'list' ? 'list' : stageBar.querySelector('.is-active')?.getAttribute('data-stage') || 'grid';
      sessionStorage.setItem(POSKEY, JSON.stringify({ y: window.scrollY, m: mode, v: viewBox.dataset.view }));
    } catch (e) {}
  }
  window.addEventListener('pagehide', savePos);
  window.addEventListener('beforeunload', savePos);
  stageBar.addEventListener('click', () => setTimeout(savePos, 60));
  function restorePos() {
    let s: any = null;
    try { s = JSON.parse(sessionStorage.getItem(POSKEY) || 'null'); } catch (e) {}
    if (!s) return;
    if (s.v === 'list') {
      setView('list');
    } else if (s.m && s.m !== 'grid') {
      const btn = stageBar.querySelector(`[data-stage="${s.m}"]`);
      if (btn) (btn as HTMLButtonElement).click();
    }
    window.scrollTo({ top: s.y || 0, behavior: 'auto' });
  }
  requestAnimationFrame(() => requestAnimationFrame(restorePos));

  // 初始视图
  setView((localStorage.getItem(KEY_VIEW) as 'grid' | 'list') || 'grid');
</script>
