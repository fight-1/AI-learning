---
import SkinSwitcher from './SkinSwitcher.astro';

const links = [
  { href: '/', label: '首页' },
  { href: '/notes', label: '笔记' },
  { href: '/archive', label: '归档' },
  { href: '/categories', label: '分类' },
  { href: '/tags', label: '标签' },
  { href: '/favorites', label: '收藏' },
  { href: '/console', label: '控制台' },
  { href: '/drafts', label: '草稿' },
  { href: '/about', label: '关于' },
];
const path = Astro.url.pathname;
---

<header class="nav">
  <div class="nav-inner">
    <a href="/" class="logo">fight<span class="logo-num">-1</span></a>

    <nav class="nav-links">
      {links.map((l) => (
        <a href={l.href} class:list={['nav-link', { active: path === l.href || (l.href !== '/' && path.startsWith(l.href)) }]}>
          {l.label}
        </a>
      ))}
    </nav>

    <div class="nav-controls">
      <button class="radar-trigger" data-radar aria-label="深空雷达搜索">📡 雷达</button>
      <a href="/search" class="ctrl" aria-label="搜索">搜索</a>
      <button class="ctrl" data-skin-trigger aria-label="切换皮肤">战甲</button>
      <button class="ctrl theme-toggle" data-theme-toggle aria-label="切换亮暗">☾</button>
      <SkinSwitcher />
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    backdrop-filter: blur(12px);
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    position: relative;
    margin: 0 auto;
    max-width: 72rem;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 12px 16px;
  }
  .logo {
    font-size: 18px;
    font-weight: 600;
    color: var(--text);
    letter-spacing: 0.5px;
  }
  .logo:hover {
    text-decoration: none;
  }
  .logo-num {
    color: var(--accent);
  }
  .nav-links {
    display: flex;
    gap: 4px;
    margin-left: 8px;
  }
  .nav-link {
    color: var(--muted);
    padding: 6px 10px;
    border-radius: 8px;
    font-size: 14px;
  }
  .nav-link:hover {
    color: var(--text);
    text-decoration: none;
    background: var(--surface-2);
  }
  .nav-link.active {
    color: var(--accent);
  }
  .nav-controls {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .ctrl {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    height: 36px;
    padding: 0 10px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    color: var(--text);
    font-size: 13px;
    cursor: pointer;
    font-family: inherit;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .ctrl:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .theme-toggle {
    font-size: 16px;
  }
  @media (max-width: 640px) {
    .nav-links {
      display: none;
    }
  }
</style>
