---
import { formatDate } from '../lib/notes';
const { note } = Astro.props;
const { title, summary, category, tags, date, featured } = note.data;
const url = `/notes/${note.id}`;
// 成熟度徽章（卡片用简短标签，与文章页一致）：草稿 / 成长中（默认）/ 已打磨
const MATURITY = {
  draft: { label: '草稿', icon: '🌱', cls: 'draft' },
  growing: { label: '成长中', icon: '🌿', cls: 'growing' },
  polished: { label: '已打磨', icon: '💎', cls: 'polished' },
};
const mat = MATURITY[note.data.maturity || 'growing'];
---

<article class="note-card stage-card" data-reveal data-id={note.id} data-category={category} data-tags={tags.join('|')}>
  {featured && <span class="feat-corner" title="精选">★</span>}
  <a href={url} class="note-link">
    <div class="note-meta">
      <span class="chip cat-chip">{category}</span>
      <time>{formatDate(date)}</time>
      <span class="mat-badge" data-mat={mat.cls} title={`成熟度：${mat.label}`}>{mat.icon} {mat.label}</span>
    </div>
    <h3 class="note-title">{title}</h3>
    <p class="note-sum">{summary}</p>
    <div class="note-tags">
      {tags.slice(0, 4).map((t) => <span class="chip">#{t}</span>)}
    </div>
  </a>
  <div class="card-actions">
    <button class="like-btn" type="button" data-like={note.id} aria-label="注入能量">
      <span class="reactor">⚡</span> 能量
    </button>
    <button class="fav-btn" type="button" data-fav={note.id}>
      <span class="fav-icon">☆</span><span class="fav-text">收藏</span>
    </button>
  </div>
</article>

<style>
  .note-card {
    padding: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transform-style: preserve-3d;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .note-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--accent) 55%, var(--border));
    box-shadow: 0 14px 30px -16px var(--glow), 0 0 0 1px color-mix(in srgb, var(--accent) 35%, transparent);
  }
  .note-card:hover .note-title {
    color: var(--accent);
  }
  .stage-card { overflow: visible; }
  .note-card { position: relative; }
  .note-link {
    display: block;
    padding: 16px 18px 12px;
    color: var(--text);
  }
  .note-link:hover {
    text-decoration: none;
  }
  /* 顶部信息带：统一尺寸、允许换行、精选移出为角标 */
  .note-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 10px;
    padding-right: 28px; /* 给精选角标留空 */
  }
  .note-meta .chip,
  .note-meta .mat-badge,
  .note-meta time {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 11px;
    line-height: 1.5;
    border: 1px solid var(--border);
    white-space: nowrap;
  }
  .note-meta time {
    border-style: dashed;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }
  .cat-chip {
    max-width: 100px;
    overflow: hidden;
    text-overflow: ellipsis;
    background: color-mix(in srgb, var(--accent) 10%, var(--surface-2));
    color: var(--accent-color);
    border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
  }
  /* 成熟度徽章：与文章页同色系 */
  .mat-badge {
    color: var(--muted);
  }
  .mat-badge[data-mat='polished'] { color: var(--accent-color); border-color: var(--accent-color); }
  .mat-badge[data-mat='draft'] { opacity: 0.75; font-style: italic; }
  /* 精选角标：不占用 meta 行，避免拥挤 */
  .feat-corner {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 22px;
    height: 22px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--accent-2);
    color: #fff;
    font-size: 12px;
    line-height: 1;
    box-shadow: 0 0 10px color-mix(in srgb, var(--accent-2) 45%, transparent);
    z-index: 2;
  }
  .note-title {
    margin: 0 0 6px;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.4;
  }
  .note-sum {
    margin: 0 0 12px;
    font-size: 13px;
    color: var(--muted);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .note-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  /* 操作区：卡片底部一行，避免绝对定位遮挡标题 */
  .card-actions {
    display: flex;
    gap: 6px;
    padding: 0 18px 14px;
  }
  .card-actions button {
    position: static;
    transform: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 9px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface-2);
    color: var(--muted);
    font-size: 11px;
    font-family: inherit;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .card-actions button:hover {
    color: var(--accent-color);
    border-color: var(--accent-color);
  }
  .card-actions .like-btn .reactor { font-size: 11px; }
  .card-actions .fav-btn.on { color: var(--accent-2); border-color: var(--accent-2); }
  .card-actions .like-btn.liked { color: var(--accent-color); border-color: var(--accent-color); }
</style>
