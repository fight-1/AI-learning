---
import { formatDate } from '../lib/notes';
const { note } = Astro.props;
const { title, summary, category, tags, date, featured } = note.data;
const url = `/notes/${note.id}`;
---

<article class="note-card stage-card" data-reveal data-id={note.id} data-category={category} data-tags={tags.join('|')}>
  <a href={url} class="note-link">
    <div class="note-meta">
      <span class="chip">{category}</span>
      <time>{formatDate(date)}</time>
      {featured && <span class="chip feat">精选</span>}
    </div>
    <h3 class="note-title">{title}</h3>
    <p class="note-sum">{summary}</p>
    <div class="note-tags">
      {tags.slice(0, 4).map((t) => <span class="chip">#{t}</span>)}
    </div>
  </a>
  <div class="card-actions">
    <button class="like-btn" type="button" data-like={note.id} aria-label="注入能量">
      <span class="reactor">⚛</span> 能量
    </button>
    <button class="fav-btn" type="button" data-fav={note.id}>☆ 收藏</button>
  </div>
</article>

<style>
  .note-card {
    padding: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transform-style: preserve-3d;
  }
  .stage-card { overflow: visible; }
  .note-link {
    display: block;
    padding: 16px 18px;
    color: var(--text);
  }
  .note-link:hover {
    text-decoration: none;
  }
  .note-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 8px;
  }
  .feat {
    color: var(--accent-2);
    border-color: var(--accent-2);
  }
  .note-title {
    margin: 0 0 6px;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.4;
  }
  .note-sum {
    margin: 0 0 12px;
    font-size: 13px;
    color: var(--muted);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .note-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  /* 操作区：卡片底部一行，避免绝对定位遮挡标题 */
  .card-actions {
    display: flex;
    gap: 8px;
    padding: 0 18px 14px;
  }
  .card-actions button {
    position: static;
    transform: none;
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface-2);
    color: var(--muted);
    font-size: 12px;
    font-family: inherit;
    cursor: pointer;
  }
  .card-actions button:hover {
    color: var(--accent-color);
    border-color: var(--accent-color);
  }
  .card-actions .like-btn .reactor { font-size: 12px; }
  .card-actions .fav-btn.on { color: var(--accent-2); border-color: var(--accent-2); }
  .card-actions .like-btn.liked { color: var(--accent-color); border-color: var(--accent-color); }
</style>
