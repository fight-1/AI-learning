# Cloudflare Pages 响应头：缓存 + 基础安全头
# CF 默认已开启 Brotli/Gzip 压缩，这里只设缓存策略与安全头。

# 构建产物（Astro 带 hash 的文件名，永不改变内容）→ 极强缓存
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# 带 hash 的静态资源
/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
/*.woff
  Cache-Control: public, max-age=31536000, immutable

# 图片：内容可能更新，给 1 天缓存
/*.svg
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.gif
  Cache-Control: public, max-age=86400

# 全站基础安全头（不动 CSP：站点大量内联脚本，强 CSP 会破坏渲染）
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=()
